[
  {
    "name": "hwp_convert",
    "description": "Report lossy HWP/HWPX/DOCX export through HWPX. DOC/ODT/RTF require LibreOffice. Writes a new file only with output plus acknowledgeRisks: true.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "to": {
          "type": "string",
          "enum": [
            "hwp",
            "hwpx",
            "docx"
          ]
        },
        "output": {
          "type": "string"
        },
        "acknowledgeRisks": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "to"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "hwp_session",
    "description": "Read the desktop Agent link session and up to 200 bounded proposals and their outcomes. Does not write files.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "hwp_propose",
    "description": "Validate a patch or edit preview and write a new Agent link proposal for desktop review. This does not edit the document.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "patch": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "schemaVersion": {
                  "const": 1
                },
                "baseSha256": {
                  "type": "string"
                },
                "operations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "op": {
                        "const": "set_text"
                      },
                      "nodeId": {
                        "type": "string"
                      },
                      "expectedText": {
                        "type": "string"
                      },
                      "text": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "op",
                      "nodeId",
                      "expectedText",
                      "text"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1,
                  "maxItems": 1000
                }
              },
              "required": [
                "schemaVersion",
                "baseSha256",
                "operations"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "patch": {
                  "type": "object",
                  "properties": {
                    "schemaVersion": {
                      "const": 1
                    },
                    "baseSha256": {
                      "type": "string"
                    },
                    "operations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "op": {
                            "const": "set_text"
                          },
                          "nodeId": {
                            "type": "string"
                          },
                          "expectedText": {
                            "type": "string"
                          },
                          "text": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "op",
                          "nodeId",
                          "expectedText",
                          "text"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 1,
                      "maxItems": 1000
                    }
                  },
                  "required": [
                    "schemaVersion",
                    "baseSha256",
                    "operations"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "patch"
              ]
            }
          ]
        }
      },
      "required": [
        "path",
        "title",
        "patch"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
