  {
    "name": "hwp_read",
    "description": "Return paged text with short references mapped to full node IDs, table grid lines and warning codes. Call first to locate text and identify read-only nodes.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "hwp_search",
    "description": "Return matching full node IDs, character offsets, context and editability. Regex accepts fixed-width syntax only; repetitions, groups and branches are refused.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "regex": {
          "type": "boolean"
        },
        "caseSensitive": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        }
      },
      "required": [
        "path",
        "query"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "hwp_replace",
    "description": "Return a hash-bound find/replace patch, diff and skipped targets; replacement text is literal. Supplying output and acknowledgeRisks saves a verified new file.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "acknowledgeRisks": {
          "type": "boolean"
        },
        "regex": {
          "type": "boolean"
        },
        "caseSensitive": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "find": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "replaceWith": {
          "type": "string",
          "maxLength": 200000
        },
        "nodeIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 1000
