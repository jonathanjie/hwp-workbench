outputs/

# Rust builds (workers use a shared target folder outside the repo)
/target/

# Self-authored, frozen inputs for Rust regression tests
!tests/data/*.hwp
!tests/data/*.hwpx
!tests/data/*.docx

# Tauri renderer build output
/app/dist/

# Tauri command permissions and schemas generated by the build script
/app/src-tauri/gen/
/app/src-tauri/permissions/autogenerated/

# Tauri macOS packages
/dist-mac/

# The vendored rhwp library compiles its own small blank templates and test
# documents into itself; they are part of its source, not user documents.
!third_party/rhwp/**/*.hwp
!third_party/rhwp/**/*.hwpx
