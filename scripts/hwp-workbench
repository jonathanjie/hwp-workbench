#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUNDLED_PYTHON="$ROOT/../python/bin/python3"

if [[ -x "$BUNDLED_PYTHON" ]]; then
  PYTHON_COMMAND="$BUNDLED_PYTHON"
else
  PYTHON_COMMAND="${HWP_WORKBENCH_PYTHON:-python3}"
fi

export PYTHONPATH="$ROOT/engine${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONUTF8=1
export PYTHONDONTWRITEBYTECODE=1

# The installed Electron executable supplies Node for rhwp, including MCP calls.
BUNDLED_NODE="$ROOT/../../MacOS/HWP Workbench"
if [[ -z "${HWP_WORKBENCH_NODE:-}" && -x "$BUNDLED_NODE" ]]; then
  export HWP_WORKBENCH_NODE="$(cd "$ROOT/../../MacOS" && pwd)/HWP Workbench"
  export ELECTRON_RUN_AS_NODE=1
fi

exec "$PYTHON_COMMAND" -m hwp_workbench "$@"
