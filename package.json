{
  "name": "hwp-workbench",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Internal HWP/HWPX editing workbench — preservation-first development alpha",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "python3 scripts/run-tests.py",
    "fixtures": "python3 scripts/generate-fixtures.py",
    "check": "node desktop/check.cjs && node --check scripts/package-mac.cjs && bash -n scripts/hwp-workbench",
    "package:mac": "node scripts/package-mac.cjs",
    "test:electron": "node scripts/test-electron.mjs",
    "test:desktop": "node --test desktop/tests/*.test.*",
    "test:differential": "python3 scripts/differential.py --candidate \"python3 -m hwp_workbench\""
  },
  "devDependencies": {
    "electron": "44.5.1",
    "playwright": "1.64.0"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@rhwp/core": "0.8.7"
  }
}
