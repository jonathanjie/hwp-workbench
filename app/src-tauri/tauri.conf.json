{
  "productName": "HWP Workbench",
  "version": "0.2.0-alpha.2",
  "identifier": "io.github.jonathanjie.hwp-workbench",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build:frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "fileAssociations": [
      {
        "ext": [
          "hwp"
        ],
        "name": "HWP document",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/x-hwp"
      },
      {
        "ext": [
          "hwpx"
        ],
        "name": "HWPX document",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/hwp+zip"
      }
    ],
    "resources": {
      "../../skills/hwp-workbench/SKILL.md": "app/skills/hwp-workbench/SKILL.md",
      "../../skills/hwp-workbench/references/patch-format.md": "app/skills/hwp-workbench/references/patch-format.md",
      "../../fixtures/generated/legacy-review.hwp": "app/fixtures/generated/legacy-review.hwp",
      "../../fixtures/generated/review-form.hwpx": "app/fixtures/generated/review-form.hwpx"
    }
  }
}
