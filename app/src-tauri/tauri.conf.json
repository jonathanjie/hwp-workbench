{
  "productName": "HWP Workbench",
  "version": "0.2.0-alpha.1",
  "identifier": "io.github.jonathanjie.hwp-workbench",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build:frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "fileAssociations": [
      {
        "ext": [
          "hwp"
        ],
        "name": "HWP document",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/x-hwp"
      },
      {
        "ext": [
          "hwpx"
        ],
        "name": "HWPX document",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/hwp+zip"
      }
    ],
    "resources": {
      "../../engine/bridge/rhwp-bridge.mjs": "app/engine/bridge/rhwp-bridge.mjs",
      "../../engine/hwp_workbench/__init__.py": "app/engine/hwp_workbench/__init__.py",
      "../../engine/hwp_workbench/__main__.py": "app/engine/hwp_workbench/__main__.py",
      "../../engine/hwp_workbench/agent_link.py": "app/engine/hwp_workbench/agent_link.py",
      "../../engine/hwp_workbench/agent_ops.py": "app/engine/hwp_workbench/agent_ops.py",
      "../../engine/hwp_workbench/cfb.py": "app/engine/hwp_workbench/cfb.py",
      "../../engine/hwp_workbench/cli.py": "app/engine/hwp_workbench/cli.py",
      "../../engine/hwp_workbench/convert/__init__.py": "app/engine/hwp_workbench/convert/__init__.py",
      "../../engine/hwp_workbench/convert/docx_read.py": "app/engine/hwp_workbench/convert/docx_read.py",
      "../../engine/hwp_workbench/convert/docx_write.py": "app/engine/hwp_workbench/convert/docx_write.py",
      "../../engine/hwp_workbench/convert/hwpx_read_rich.py": "app/engine/hwp_workbench/convert/hwpx_read_rich.py",
      "../../engine/hwp_workbench/convert/hwpx_write.py": "app/engine/hwp_workbench/convert/hwpx_write.py",
      "../../engine/hwp_workbench/convert/libreoffice.py": "app/engine/hwp_workbench/convert/libreoffice.py",
      "../../engine/hwp_workbench/convert/model.py": "app/engine/hwp_workbench/convert/model.py",
      "../../engine/hwp_workbench/convert/operation.py": "app/engine/hwp_workbench/convert/operation.py",
      "../../engine/hwp_workbench/convert/package.py": "app/engine/hwp_workbench/convert/package.py",
      "../../engine/hwp_workbench/convert/style_index.py": "app/engine/hwp_workbench/convert/style_index.py",
      "../../engine/hwp_workbench/desktop_open.py": "app/engine/hwp_workbench/desktop_open.py",
      "../../engine/hwp_workbench/document.py": "app/engine/hwp_workbench/document.py",
      "../../engine/hwp_workbench/errors.py": "app/engine/hwp_workbench/errors.py",
      "../../engine/hwp_workbench/format_readout.py": "app/engine/hwp_workbench/format_readout.py",
      "../../engine/hwp_workbench/hwp_records.py": "app/engine/hwp_workbench/hwp_records.py",
      "../../engine/hwp_workbench/independent.py": "app/engine/hwp_workbench/independent.py",
      "../../engine/hwp_workbench/mcp.py": "app/engine/hwp_workbench/mcp.py",
      "../../engine/hwp_workbench/mcp_config.py": "app/engine/hwp_workbench/mcp_config.py",
      "../../engine/hwp_workbench/package_io.py": "app/engine/hwp_workbench/package_io.py",
      "../../engine/hwp_workbench/service.py": "app/engine/hwp_workbench/service.py",
      "../../engine/hwp_workbench/skill_install.py": "app/engine/hwp_workbench/skill_install.py",
      "../../engine/hwp_workbench/workspace.py": "app/engine/hwp_workbench/workspace.py",
      "../../engine/hwp_workbench/xml_io.py": "app/engine/hwp_workbench/xml_io.py",
      "../../mcpb/icon.png": "app/mcpb/icon.png",
      "../../mcpb/launch.py": "app/mcpb/launch.py",
      "../../mcpb/manifest.json": "app/mcpb/manifest.json",
      "../../skills/hwp-workbench/SKILL.md": "app/skills/hwp-workbench/SKILL.md",
      "../../skills/hwp-workbench/references/patch-format.md": "app/skills/hwp-workbench/references/patch-format.md",
      "../../fixtures/generated/legacy-review.hwp": "app/fixtures/generated/legacy-review.hwp",
      "../../fixtures/generated/review-form.hwpx": "app/fixtures/generated/review-form.hwpx",
      "../../desktop/agent-files.py": "app/desktop/agent-files.py",
      "../../scripts/build-mcpb.py": "app/scripts/build-mcpb.py",
      "../../scripts/hwp-workbench": "app/scripts/hwp-workbench",
      "../../node_modules/@rhwp/core/rhwp.js": "app/node_modules/@rhwp/core/rhwp.js",
      "../../node_modules/@rhwp/core/rhwp_bg.wasm": "app/node_modules/@rhwp/core/rhwp_bg.wasm",
      "../../node_modules/@rhwp/core/package.json": "app/node_modules/@rhwp/core/package.json",
      "../../node_modules/@rhwp/core/LICENSE": "app/node_modules/@rhwp/core/LICENSE"
    }
  }
}
